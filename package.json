{
  "name": "orbit-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "agent-bridge",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:sidecar && ORBIT_LOG_MODE=dev tauri dev",
    "dev:debug": "bun run build:sidecar && ORBIT_LOG_MODE=debug tauri dev",
    "dev:quiet": "bun run build:sidecar && ORBIT_LOG_MODE=prod tauri dev",
    "dev:web": "vite",
    "devtools": "react-devtools",
    "build": "bun run build:sidecar && ./scripts/build-with-env.sh",
    "build:debug": "bun run build:sidecar && ./scripts/build-with-env.sh --debug",
    "build:frontend": "tsc --noEmit && vite build",
    "build:sidecar": "mkdir -p src-tauri/binaries && cd agent-bridge && bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile ../src-tauri/binaries/agent-bridge-aarch64-apple-darwin && bun scripts/build-claude-cli.mjs",
    "analyze": "vite build && open dist/stats.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/agent/src apps/Canvas-UI-Builder/src apps/editor/src apps/common/src agent-bridge/src packages/shared-schemas/src scripts vite-plugins vitest.setup.ts --max-warnings=0",
    "lint:fix": "eslint apps/agent/src apps/Canvas-UI-Builder/src apps/editor/src apps/common/src agent-bridge/src packages/shared-schemas/src scripts vite-plugins vitest.setup.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:agent": "vitest run apps/agent",
    "test:canvas": "vitest run apps/Canvas-UI-Builder",
    "test:editor": "vitest run apps/editor",
    "test:common": "vitest run apps/common",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:fmt:fix": "cargo fmt --all",
    "rust:lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "rust:lint:fix": "cargo clippy --fix --allow-dirty --allow-staged",
    "rust:test": "cargo test --all-features",
    "rust:test:verbose": "cargo test --all-features -- --nocapture",
    "rust:build": "cargo build --all-features",
    "rust:build:release": "cargo build --all-features --release",
    "rust:check": "cargo check --all-features",
    "bridge:typecheck": "cd agent-bridge && bun run typecheck",
    "bridge:test": "cd agent-bridge && bun test",
    "common:typecheck": "cd apps/common && bun run typecheck",
    "schemas:typecheck": "cd packages/shared-schemas && bun run typecheck",
    "check": "bun run typecheck && bun run canvas:typecheck && bun run common:typecheck && bun run bridge:typecheck && bun run schemas:typecheck && bun run lint && bun run test",
    "check:rust": "bun run rust:fmt && bun run rust:lint && bun run rust:test",
    "check:all": "bun run check && bun run check:rust",
    "lint:all": "./scripts/lint-all.sh",
    "lint:all:fix": "./scripts/lint-all.sh --fix",
    "lint:all:fast": "./scripts/lint-all.sh --no-test",
    "fix": "bun run lint:fix && bun run rust:fmt:fix",
    "clean": "rm -rf dist node_modules/.vite target/debug target/release coverage",
    "clean:rust": "cargo clean",
    "ci": "bun run typecheck && bun run canvas:typecheck && bun run common:typecheck && bun run bridge:typecheck && bun run schemas:typecheck && bun run lint && bun run test && bun run rust:fmt && bun run rust:lint && bun run rust:test",
    "prepare": "husky",
    "canvas:dev": "vite --config vite.config.canvas.ts",
    "canvas:build": "tsc -p tsconfig.canvas.json --noEmit && vite build --config vite.config.canvas.ts",
    "canvas:build:skip-lint": "vite build --config vite.config.canvas.ts",
    "canvas:preview": "vite preview --config vite.config.canvas.ts",
    "canvas:typecheck": "tsc -p tsconfig.canvas.json --noEmit",
    "canvas:lint": "eslint apps/Canvas-UI-Builder/src --max-warnings=0",
    "canvas:lint:fix": "eslint apps/Canvas-UI-Builder/src --fix",
    "canvas:check": "bun run canvas:typecheck && bun run canvas:lint",
    "canvas:test": "vitest run apps/Canvas-UI-Builder",
    "knip": "knip -W . -W apps/agent -W apps/Canvas-UI-Builder -W apps/editor -W apps/common -W packages/shared-schemas",
    "knip:fix": "knip -W . -W apps/agent -W apps/Canvas-UI-Builder -W apps/editor -W apps/common -W packages/shared-schemas --fix",
    "knip:watch": "knip -W . -W apps/agent -W apps/Canvas-UI-Builder -W apps/editor -W apps/common -W packages/shared-schemas --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.12",
    "@babel/generator": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
