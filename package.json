{
  "name": "orbit-ui",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "workspaces": [
    "apps/*",
    "agent-bridge",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:sidecar && ORBIT_LOG_MODE=dev tauri dev",
    "dev:debug": "bun run build:sidecar && ORBIT_LOG_MODE=debug tauri dev",
    "dev:quiet": "bun run build:sidecar && ORBIT_LOG_MODE=prod tauri dev",
    "dev:web": "vite",
    "devtools": "react-devtools",
    "build": "bun run build:sidecar && bun run verify:binaries && ./scripts/build-with-env.sh",
    "build:debug": "bun run build:sidecar && bun run verify:binaries && ./scripts/build-with-env.sh --debug",
    "build:frontend": "tsc --noEmit && vite build",
    "verify:binaries": "bun run ./scripts/verify-binaries.ts",
    "build:sidecar": "mkdir -p src-tauri/binaries && cd agent-bridge && bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile ../src-tauri/binaries/agent-bridge-aarch64-apple-darwin && bun scripts/build-claude-cli.mjs",
    "analyze": "vite build && open dist/stats.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/agent/src apps/editor/src apps/common/src agent-bridge/src packages/shared-schemas/src vite-plugins vitest.setup.ts --max-warnings=0",
    "lint:fix": "eslint apps/agent/src apps/editor/src apps/common/src agent-bridge/src packages/shared-schemas/src vite-plugins vitest.setup.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:agent": "vitest run apps/agent",
    "test:editor": "vitest run apps/editor",
    "test:common": "vitest run apps/common",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:fmt:fix": "cargo fmt --all",
    "rust:lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "rust:lint:fix": "cargo clippy --fix --allow-dirty --allow-staged",
    "rust:test": "cargo test --all-features",
    "rust:test:verbose": "cargo test --all-features -- --nocapture",
    "rust:build": "cargo build --all-features",
    "rust:build:release": "cargo build --all-features --release",
    "rust:check": "cargo check --all-features",
    "bridge:typecheck": "cd agent-bridge && bun run typecheck",
    "bridge:test": "cd agent-bridge && bun test",
    "common:typecheck": "cd apps/common && bun run typecheck",
    "schemas:typecheck": "cd packages/shared-schemas && bun run typecheck",
    "check": "bun run typecheck && bun run common:typecheck && bun run bridge:typecheck && bun run schemas:typecheck && bun run lint && bun run test",
    "check:rust": "bun run rust:fmt && bun run rust:lint && bun run rust:test",
    "check:all": "bun run check && bun run check:rust",
    "lint:all": "./scripts/lint-all.sh",
    "lint:all:fix": "./scripts/lint-all.sh --fix",
    "lint:all:fast": "./scripts/lint-all.sh --no-test",
    "fix": "bun run lint:fix && bun run rust:fmt:fix",
    "clean": "rm -rf dist node_modules/.vite target/debug target/release coverage",
    "clean:rust": "cargo clean",
    "ci": "bun run typecheck && bun run common:typecheck && bun run bridge:typecheck && bun run schemas:typecheck && bun run lint && bun run test && bun run rust:fmt && bun run rust:lint && bun run rust:test",
    "prepare": "husky",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:watch": "knip --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@central-icons-react/round-outlined-radius-1-stroke-2": "^1.1.121",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/lint": "^6.9.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.13",
    "@emotion/is-prop-valid": "^1.4.0",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@lexical/react": "^0.41.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/lab": "^0.1.2",
    "@milkdown/crepe": "^7.18.0",
    "@orbit/shared-schemas": "workspace:*",
    "@pierre/diffs": "1.1.3",
    "@pierre/theme": "^0.0.24",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.38.0",
    "@sentry/vite-plugin": "^5.0.0",
    "@streamdown/code": "^1.0.1",
    "@streamdown/mermaid": "^1.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "facehash": "^0.1.0",
    "immer": "^11.1.3",
    "lexical": "^0.41.0",
    "lucide-react": "^0.576.0",
    "motion": "^12.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-virtuoso": "^4.18.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tauri-plugin-liquid-glass-api": "^0.1.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.1",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-devtools": "^7.0.1",
    "react-grab": "^0.1.19",
    "react-scan": "^0.5.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "qs": ">=6.14.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.13",
    "shiki": "^3.22.0"
  }
}
