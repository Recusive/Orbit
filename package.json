{
  "name": "snowflake-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "SNOWFLAKE_LOG_MODE=dev tauri dev",
    "dev:debug": "SNOWFLAKE_LOG_MODE=debug tauri dev",
    "dev:quiet": "SNOWFLAKE_LOG_MODE=prod tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:frontend": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src agent-bridge/src --max-warnings=0",
    "lint:fix": "eslint src agent-bridge/src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:fmt:fix": "cargo fmt --all",
    "rust:lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "rust:lint:fix": "cargo clippy --fix --allow-dirty --allow-staged",
    "rust:test": "cargo test --all-features",
    "rust:test:verbose": "cargo test --all-features -- --nocapture",
    "rust:build": "cargo build --all-features",
    "rust:build:release": "cargo build --all-features --release",
    "rust:check": "cargo check --all-features",
    "check": "pnpm typecheck && pnpm lint",
    "check:rust": "pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "check:all": "pnpm check && pnpm check:rust",
    "fix": "pnpm lint:fix && pnpm rust:fmt:fix",
    "clean": "rm -rf dist node_modules/.vite target/debug target/release",
    "clean:rust": "cargo clean",
    "ci": "pnpm typecheck && pnpm lint && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "prepare": "husky"
  },
  "dependencies": {
    "@central-icons-react/round-outlined-radius-1-stroke-2": "^1.1.83",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.8.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.39.5",
    "@lexical/react": "^0.39.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/lab": "^0.1.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
