#!/usr/bin/env bash
#
# orbitctl — command-line helper for Orbit Terminal
#
# Communicates with the running Orbit Terminal instance via a Unix domain socket.
# Socket path: /tmp/orbit-terminal-$(id -u).sock
#
# Usage:
#   orbitctl <command> [options]
#
# Commands:
#   rename <title>                 Rename the current tab
#   notify [--title T] [--body B]  Send a notification
#   set-status <key> <value> [--icon SYMBOL]  Set a status entry in the sidebar
#   clear-status <key>             Remove a status entry
#   list                           List all tabs (JSON)
#   current                        Show current tab info (JSON)
#
# Environment:
#   ORBIT_TERMINAL_SOCKET  Override the default socket path
#   ORBIT_TERMINAL_TAB_ID  Override the tab ID (default: auto-detect from env)

set -euo pipefail

# Resolve socket path
SOCKET="${ORBIT_TERMINAL_SOCKET:-/tmp/orbit-terminal-$(id -u).sock}"
TAB_ID="${ORBIT_TERMINAL_TAB_ID:-}"

die() {
    echo "orbitctl: error: $*" >&2
    exit 1
}

# Send a JSON request and print the response
send_request() {
    local json="$1"
    if ! command -v nc &>/dev/null; then
        die "nc (netcat) is required but not found"
    fi

    # Use nc to send the request and read the response
    echo "$json" | nc -U "$SOCKET" 2>/dev/null || die "cannot connect to $SOCKET — is Orbit Terminal running?"
}

# Build params JSON with optional tab_id
params_with_tab_id() {
    local extra="$1"
    if [ -n "$TAB_ID" ]; then
        if [ -n "$extra" ]; then
            echo "{\"tab_id\": \"$TAB_ID\", $extra}"
        else
            echo "{\"tab_id\": \"$TAB_ID\"}"
        fi
    else
        if [ -n "$extra" ]; then
            echo "{$extra}"
        else
            echo "{}"
        fi
    fi
}

cmd_rename() {
    local title=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --tab-id) TAB_ID="$2"; shift 2 ;;
            *) title="$1"; shift ;;
        esac
    done

    [ -n "$title" ] || die "usage: orbitctl rename <title>"

    local params
    params=$(params_with_tab_id "\"title\": \"$title\"")
    send_request "{\"method\": \"tab.rename\", \"params\": $params}"
}

cmd_notify() {
    local title="Orbit Terminal"
    local body=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --title) title="$2"; shift 2 ;;
            --body) body="$2"; shift 2 ;;
            --tab-id) TAB_ID="$2"; shift 2 ;;
            *) body="$1"; shift ;;
        esac
    done

    local params
    params=$(params_with_tab_id "\"title\": \"$title\", \"body\": \"$body\"")
    send_request "{\"method\": \"tab.notify\", \"params\": $params}"
}

cmd_set_status() {
    local key=""
    local value=""
    local icon=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --icon) icon="$2"; shift 2 ;;
            --tab-id) TAB_ID="$2"; shift 2 ;;
            *)
                if [ -z "$key" ]; then
                    key="$1"
                elif [ -z "$value" ]; then
                    value="$1"
                fi
                shift
                ;;
        esac
    done

    [ -n "$key" ] && [ -n "$value" ] || die "usage: orbitctl set-status <key> <value> [--icon SYMBOL]"

    local extra="\"key\": \"$key\", \"value\": \"$value\""
    if [ -n "$icon" ]; then
        extra="$extra, \"icon\": \"$icon\""
    fi
    local params
    params=$(params_with_tab_id "$extra")
    send_request "{\"method\": \"tab.set-status\", \"params\": $params}"
}

cmd_clear_status() {
    local key=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --tab-id) TAB_ID="$2"; shift 2 ;;
            *) key="$1"; shift ;;
        esac
    done

    [ -n "$key" ] || die "usage: orbitctl clear-status <key>"

    local params
    params=$(params_with_tab_id "\"key\": \"$key\"")
    send_request "{\"method\": \"tab.clear-status\", \"params\": $params}"
}

cmd_list() {
    send_request '{"method": "tab.list"}'
}

cmd_current() {
    send_request '{"method": "tab.current"}'
}

cmd_help() {
    cat <<'EOF'
orbitctl — command-line helper for Orbit Terminal

Usage:
  orbitctl <command> [options]

Commands:
  rename <title>                         Rename the current tab
  notify [--title T] [--body B] [text]   Send a notification
  set-status <key> <value> [--icon SYM]  Set a status entry in the sidebar
  clear-status <key>                     Remove a status entry
  list                                   List all tabs (JSON)
  current                                Show current tab info (JSON)

Global Options:
  --tab-id <uuid>    Target a specific tab instead of the current one

Environment:
  ORBIT_TERMINAL_SOCKET    Override the socket path
  ORBIT_TERMINAL_TAB_ID    Override the tab ID

Examples:
  orbitctl rename "My Project"
  orbitctl notify --title "Build" --body "Complete!"
  orbitctl set-status git "main" --icon "arrow.triangle.branch"
  orbitctl clear-status git
  orbitctl list | jq '.result.tabs'
EOF
}

# Main dispatch
[ $# -gt 0 ] || { cmd_help; exit 0; }

command="$1"
shift

case "$command" in
    rename)       cmd_rename "$@" ;;
    notify)       cmd_notify "$@" ;;
    set-status)   cmd_set_status "$@" ;;
    clear-status) cmd_clear_status "$@" ;;
    list)         cmd_list "$@" ;;
    current)      cmd_current "$@" ;;
    help|--help|-h) cmd_help ;;
    *) die "unknown command: $command (try 'orbitctl help')" ;;
esac
