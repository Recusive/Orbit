{
  "compilerOptions": {
    /* Base */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    /* Vitest globals for testing (describe, it, expect, vi) */
    "types": ["vitest/globals", "@testing-library/jest-dom"],

    /* Emit */
    "noEmit": true,

    /* Maximum Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,

    /* Paths - Canvas UI Builder specific */
    /* @/ resolves to agent (shared modules), @canvas/ for canvas-specific */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/agent/src/*"],
      "@canvas/*": ["./apps/Canvas-UI-Builder/src/*"],
      "@orbit.build/sdk": ["./packages/orbit-sdk/src/v2/index.d.ts"],
      "@orbit.build/sdk/v2": ["./packages/orbit-sdk/src/v2/index.d.ts"],
      "@orbit.build/sdk/v2/client": ["./packages/orbit-sdk/src/v2/client.d.ts"],
      "@orbit/common": ["./apps/common/src/index.ts"],
      "@orbit/common/*": ["./apps/common/src/*"]
    }
  },
  "include": ["apps/Canvas-UI-Builder/src/**/*", "apps/agent/src/vite-env.d.ts"]
}
