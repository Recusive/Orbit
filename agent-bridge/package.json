{
  "name": "agent-bridge",
  "version": "0.0.1",
  "description": "Claude Agent SDK bridge for Orbit",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external",
    "build:bundle": "bun build src/index.ts --outdir dist --target bun --minify",
    "build:dev": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile ../target/debug/agent-bridge",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.44",
    "@anthropic-ai/claude-code": "^2.0.76",
    "@anthropic-ai/sdk": "^0.74.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@orbit/shared-schemas": "workspace:*",
    "@sentry/bun": "^10.38.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.3.5",
    "knip": "^5.80.0",
    "typescript": "^5.7.2"
  }
}
