{
  "name": "agent-bridge",
  "version": "0.1.0",
  "description": "Claude Agent SDK bridge for Snowflake",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean --sourcemap",
    "build:bundle": "tsup src/index.ts --format esm --target node18 --clean --minify --no-splitting",
    "dev": "tsup src/index.ts --format esm --target node18 --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@anthropic-ai/claude-code": "^2.0.76",
    "@anthropic-ai/sdk": "^0.71.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@snowflake/shared-schemas": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
