  </layouts>

  <!-- ============================================================
       SECTION 11: OVERFLOW & CLIPPING
       ============================================================ -->
  <overflow-handling>
    <problem>
      overflow: hidden clips borders, focus rings, and shadows of child elements.
      This is especially problematic in animated containers.
    </problem>

    <solution name="animated-containers">
      <description>
        Track animation state and switch overflow after animation completes.
      </description>
      <code>
        <![CDATA[
const [isAnimating, setIsAnimating] = useState(false);

useEffect(() => {
  setIsAnimating(true);
  const timer = setTimeout(() => setIsAnimating(false), 200);
  return () => clearTimeout(timer);
}, [open]);

<div style={{
  overflow: (!open || isAnimating) ? 'hidden' : 'visible',
  // ... other animation styles
}}>
        ]]>
      </code>
    </solution>

    <solution name="scrollable-containers">
      <description>
        Avoid overflow-x-hidden on scrollable areas if children have borders.
        Use overflow-y-auto alone, or add internal padding.
      </description>
      <good>overflow-y-auto (no overflow-x-hidden)</good>
      <bad>overflow-y-auto overflow-x-hidden (clips side borders)</bad>
    </solution>
  </overflow-handling>

  <!-- ============================================================
       SECTION 12: CHECKLIST FOR NEW COMPONENTS
       ============================================================ -->
  <checklist>
    <item category="colors">
      <check>Using semantic color tokens (--primary, --muted, etc.)?</check>
      <check>Opacity variants for subtle states (/30, /50, /70)?</check>
      <check>No hard-coded colors?</check>
    </item>

    <item category="spacing">
      <check>Consistent padding with similar components?</check>
      <check>Generous whitespace (px-5/px-6 for panels)?</check>
      <check>Proper gaps between elements?</check>
    </item>

    <item category="borders">
      <check>Using rounded-lg or larger?</check>
      <check>Subtle borders (border-border/50)?</check>
      <check>Or no borders (shadow-only)?</check>
    </item>

    <item category="interactions">
      <check>Hover state defined?</check>
      <check>Focus state visible but subtle?</check>
      <check>Active/press state (scale-[0.98])?</check>
      <check>Disabled state (opacity-40 or opacity-50)?</check>
    </item>

    <item category="transitions">
      <check>transition-all duration-150 or duration-200?</check>
      <check>ease-out easing?</check>
      <check>Respects prefers-reduced-motion?</check>
    </item>

    <item category="typography">
      <check>Using defined text sizes (text-sm, text-xs, text-[13px])?</check>
      <check>Proper font weights?</check>
      <check>Muted colors for secondary text?</check>
    </item>

    <item category="accessibility">
      <check>Focus-visible states?</check>
      <check>Sufficient color contrast?</check>
      <check>Interactive elements have hover/focus feedback?</check>
    </item>
  </checklist>

  <!-- ============================================================
       SECTION 13: ANTI-PATTERNS TO AVOID
       ============================================================ -->
  <anti-patterns>
    <avoid name="bright-focus-rings">
      <bad>focus:ring-2 focus:ring-primary</bad>
      <good>focus-visible:ring-1 focus-visible:ring-ring (with subtle --ring)</good>
    </avoid>

    <avoid name="hard-borders">
      <bad>border border-gray-300</bad>
      <good>border-none shadow-lg OR border border-border/50</good>
    </avoid>

    <avoid name="small-click-targets">
      <bad>h-6 px-2 (too small)</bad>
      <good>h-10 px-4 (comfortable)</good>
    </avoid>

    <avoid name="abrupt-transitions">
      <bad>No transition</bad>
      <good>transition-all duration-200 ease-out</good>
    </avoid>

    <avoid name="cramped-spacing">
      <bad>p-2 gap-1</bad>
      <good>p-5 gap-2.5 (more spacious)</good>
    </avoid>

    <avoid name="overflow-clipping">
      <bad>overflow-hidden on animated parents</bad>
      <good>Switch to overflow-visible after animation</good>
    </avoid>

    <avoid name="red-delete-buttons-at-rest">
      <bad>bg-destructive text-white (always red)</bad>
      <good>bg-muted/30 text-muted-foreground hover:bg-destructive/10 hover:text-destructive</good>
    </avoid>
  </anti-patterns>

</design-system>
