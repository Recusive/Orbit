<?xml version="1.0" encoding="UTF-8"?>
<!--
  Orbit Canvas Design System
  ==========================
  A comprehensive guide to design tokens, patterns, and conventions
  for building consistent, modern UI components.

  Last Updated: December 2024
  Inspired by: Claude.ai, ChatGPT, Linear, Figma
-->

<design-system name="orbit-canvas" version="1.0">

  <!-- ============================================================
       SECTION 1: DESIGN PHILOSOPHY
       ============================================================ -->
  <philosophy>
    <principle name="calm">
      UI should feel calm and spacious, not cramped or aggressive.
      Use generous whitespace, soft shadows, and muted colors.
    </principle>
    <principle name="subtle">
      Interactions should be noticeable but not jarring.
      Prefer slight color shifts over bright highlights.
      Focus states should guide, not distract.
    </principle>
    <principle name="consistent">
      Every component follows the same spacing, timing, and color rules.
      Predictability builds trust and reduces cognitive load.
    </principle>
    <principle name="accessible">
      All interactive elements must have visible focus states.
      Color alone should not convey meaning.
      Support reduced-motion preferences.
    </principle>
  </philosophy>

  <!-- ============================================================
       SECTION 2: COLOR TOKENS
       ============================================================ -->
  <colors>
    <description>
      Colors are defined as CSS custom properties using OKLCH color space
      for perceptual uniformity. Reference via var(--token-name).
    </description>

    <!-- Semantic Colors -->
    <semantic>
      <token name="--background" usage="Page/app background" />
      <token name="--foreground" usage="Primary text color" />
      <token name="--card" usage="Card/panel backgrounds" />
      <token name="--card-foreground" usage="Text on cards" />
      <token name="--popover" usage="Dropdown/popover backgrounds" />
      <token name="--popover-foreground" usage="Text in popovers" />
      <token name="--primary" usage="Primary actions, active states" />
      <token name="--primary-foreground" usage="Text on primary backgrounds" />
      <token name="--secondary" usage="Secondary buttons, less emphasis" />
      <token name="--secondary-foreground" usage="Text on secondary" />
      <token name="--muted" usage="Subtle backgrounds, disabled states" />
      <token name="--muted-foreground" usage="Secondary text, placeholders" />
      <token name="--accent" usage="Hover states, highlights" />
      <token name="--accent-foreground" usage="Text on accent" />
      <token name="--destructive" usage="Delete, error states" />
      <token name="--border" usage="Borders, dividers" />
      <token name="--input" usage="Input field backgrounds" />
      <token name="--ring" usage="Focus rings (subtle, 30% opacity)" />
    </semantic>

    <!-- Opacity Patterns -->
    <opacity-patterns>
      <pattern name="subtle-background" value="bg-muted/30" usage="Very light tinted backgrounds" />
      <pattern name="hover-background" value="bg-muted/50 or bg-muted/60" usage="Hover states" />
      <pattern name="active-tint" value="bg-primary/10" usage="Active/selected item tint" />
      <pattern name="border-subtle" value="border-border/50" usage="Softer borders" />
      <pattern name="text-secondary" value="text-muted-foreground/70" usage="De-emphasized text" />
      <pattern name="text-tertiary" value="text-muted-foreground/50" usage="Placeholder, hints" />
      <pattern name="focus-border" value="border-primary/40" usage="Focus state borders" />
      <pattern name="destructive-hover" value="bg-destructive/10" usage="Delete hover background" />
    </opacity-patterns>
  </colors>

  <!-- ============================================================
       SECTION 3: SPACING SYSTEM
       ============================================================ -->
  <spacing>
    <description>
      Use Tailwind spacing scale consistently. Prefer larger values
      for a spacious feel. Group related elements tightly.
    </description>

    <!-- Standard Spacing Values -->
    <scale>
      <value name="0.5" pixels="2" usage="Micro gaps (icon badges)" />
      <value name="1" pixels="4" usage="Tight internal spacing" />
      <value name="1.5" pixels="6" usage="Small gaps" />
      <value name="2" pixels="8" usage="Default small gap" />
      <value name="2.5" pixels="10" usage="Between related items" />
      <value name="3" pixels="12" usage="Section internal padding" />
      <value name="4" pixels="16" usage="Standard padding" />
      <value name="5" pixels="20" usage="Panel padding (horizontal)" />
      <value name="6" pixels="24" usage="Panel padding (generous)" />
      <value name="8" pixels="32" usage="Between major sections" />
      <value name="10" pixels="40" usage="Large spacing" />
    </scale>

    <!-- Component Spacing Patterns -->
    <patterns>
      <pattern name="panel-padding" horizontal="px-5 or px-6" vertical="py-5 or py-6">
        Consistent padding for sidebars, panels, cards
      </pattern>
      <pattern name="section-gap" value="pt-4 pb-2 (trigger) + pb-5 (content)">
        Space between collapsible sections
      </pattern>
      <pattern name="input-group-gap" value="gap-2">
        Between input and button in same row
      </pattern>
      <pattern name="stacked-items-gap" value="space-y-3 or space-y-4">
        Vertical stack of form elements
      </pattern>
      <pattern name="grid-gap" value="gap-2.5">
        Grid of cards/buttons
      </pattern>
      <pattern name="badge-gap" value="gap-2">
        Between tags/badges
      </pattern>
    </patterns>
  </spacing>

  <!-- ============================================================
       SECTION 4: TYPOGRAPHY
       ============================================================ -->
  <typography>
    <scale>
      <size name="xs" value="text-xs (12px)" usage="Timestamps, hints, badges" />
      <size name="sm" value="text-sm (14px)" usage="Body text, inputs, buttons" />
      <size name="base" value="text-[13px]" usage="Section headers (custom)" />
      <size name="label" value="text-[11px]" usage="Uppercase labels" />
      <size name="heading" value="text-[15px]" usage="Card/panel titles" />
    </scale>

    <weights>
      <weight name="normal" value="font-normal (400)" usage="Body text" />
      <weight name="medium" value="font-medium (500)" usage="Labels, buttons, headers" />
      <weight name="semibold" value="font-semibold (600)" usage="Emphasis (rare)" />
    </weights>

    <patterns>
      <pattern name="section-label">
        <classes>text-[11px] font-medium uppercase tracking-wider text-muted-foreground/70</classes>
        <usage>Small caps labels above sections</usage>
      </pattern>
      <pattern name="section-header">
        <classes>text-[13px] font-medium text-foreground</classes>
        <usage>Collapsible section titles</usage>
      </pattern>
      <pattern name="panel-title">
        <classes>text-[15px] font-medium text-foreground</classes>
        <usage>Main panel/card titles</usage>
      </pattern>
      <pattern name="helper-text">
        <classes>text-xs text-muted-foreground/70</classes>
        <usage>Timestamps, metadata, hints</usage>
      </pattern>
      <pattern name="placeholder">
        <classes>placeholder:text-muted-foreground/50</classes>
        <usage>Input placeholder styling</usage>
      </pattern>
    </patterns>
  </typography>

  <!-- ============================================================
       SECTION 5: BORDER RADIUS
       ============================================================ -->
  <border-radius>
    <scale>
      <radius name="sm" value="rounded-sm (4px)" usage="Scrollbars, tiny badges" />
      <radius name="default" value="rounded-lg (8px)" usage="EVERYTHING - buttons, inputs, cards, panels, modals" />
      <radius name="full" value="rounded-full" usage="Pills, avatars, circular indicators" />
    </scale>

    <guidelines>
      <guideline>USE 8px (rounded-lg) EVERYWHERE for consistency</guideline>
      <guideline>Only use rounded-sm for tiny elements like scrollbars</guideline>
      <guideline>Only use rounded-full for circular/pill elements</guideline>
      <guideline>Base token: --radius: 0.5rem (8px) in globals.css</guideline>
    </guidelines>
  </border-radius>

  <!-- ============================================================
       SECTION 6: SHADOWS
       ============================================================ -->
  <shadows>
    <levels>
      <shadow name="none" value="shadow-none" usage="Flat elements" />
      <shadow name="subtle" value="shadow-sm" usage="Buttons, slight elevation" />
      <shadow name="default" value="shadow-md" usage="Cards, dropdowns" />
      <shadow name="elevated" value="shadow-lg shadow-black/10" usage="Popovers, floating panels" />
      <shadow name="prominent" value="shadow-lg shadow-primary/20" usage="Active/selected cards" />
    </levels>

    <patterns>
      <pattern name="floating-panel">
        <value>0 8px 32px rgba(0, 0, 0, 0.08), 0 4px 16px rgba(0, 0, 0, 0.04)</value>
        <usage>Sidebars, floating toolbars</usage>
      </pattern>
      <pattern name="dropdown">
        <value>shadow-lg shadow-black/10</value>
        <usage>Select dropdowns, popovers</usage>
      </pattern>
      <pattern name="active-card">
        <value>shadow-lg shadow-primary/20</value>
        <usage>Selected type cards, active items</usage>
      </pattern>
      <pattern name="hover-lift">
        <value>hover:shadow-md</value>
        <usage>Cards that lift on hover</usage>
      </pattern>
      <pattern name="inner-glow">
        <value>backgroundImage: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, transparent 60px)</value>
        <usage>Subtle depth at top of panels</usage>
      </pattern>
    </patterns>
  </shadows>

  <!-- ============================================================
       SECTION 7: TRANSITIONS & ANIMATIONS
       ============================================================ -->
  <animations>
    <timing>
      <duration name="fast" value="150ms" usage="Color changes, opacity" />
      <duration name="default" value="200ms" usage="Most interactions" />
      <duration name="slow" value="280ms" usage="Panel slides, major transitions" />
    </timing>

    <easing>
      <curve name="default" value="ease-out" usage="Standard deceleration" />
      <curve name="smooth" value="cubic-bezier(0.16, 1, 0.3, 1)" usage="Panel animations" />
      <curve name="spring" value="cubic-bezier(0.34, 1.56, 0.64, 1)" usage="Bounce effects (rare)" />
    </easing>

    <patterns>
      <pattern name="color-transition">
        <classes>transition-colors duration-150</classes>
        <usage>Hover color changes</usage>
      </pattern>
      <pattern name="all-transition">
        <classes>transition-all duration-200 ease-out</classes>
        <usage>Complex state changes (scale + color + shadow)</usage>
      </pattern>
      <pattern name="transform-transition">
        <classes>transition-transform duration-200</classes>
        <usage>Scale, rotate animations</usage>
      </pattern>
      <pattern name="expand-collapse">
        <style>height Xms ease-out, opacity Xms ease-out</style>
        <usage>Collapsible content animation</usage>
      </pattern>
    </patterns>

    <micro-interactions>
      <interaction name="button-press">
        <classes>active:scale-[0.98]</classes>
        <description>Subtle press-in effect</description>
      </interaction>
      <interaction name="card-hover">
        <classes>hover:scale-[1.02]</classes>
        <description>Slight lift on hover</description>
      </interaction>
      <interaction name="icon-rotate">
        <classes>transition-transform duration-200 rotate-90</classes>
        <description>Chevron rotation for expand/collapse</description>
      </interaction>
    </micro-interactions>
  </animations>

  <!-- ============================================================
       SECTION 8: FOCUS STATES
       ============================================================ -->
  <focus-states>
    <philosophy>
      Focus states should be visible but calm. Use subtle ring at low opacity
      combined with slight border color change. Never use bright, thick rings.
    </philosophy>

    <pattern name="input-focus">
      <classes>
        focus-visible:outline-none
        focus-visible:border-primary/40
        focus-visible:ring-1
        focus-visible:ring-ring
      </classes>
      <note>--ring is set to primary at 30% opacity</note>
    </pattern>

    <pattern name="button-focus">
      <classes>
        focus-visible:outline-none
        focus-visible:ring-1
        focus-visible:ring-ring
      </classes>
    </pattern>

    <pattern name="interactive-focus">
      <classes>
        focus:outline-none
        focus:bg-muted/60
      </classes>
      <usage>List items, menu items</usage>
    </pattern>

    <css-variable>
      <name>--ring</name>
      <light>oklch(0.62 0.18 35 / 30%)</light>
      <dark>oklch(0.68 0.19 40 / 30%)</dark>
      <description>Subtle primary color at 30% opacity</description>
    </css-variable>
  </focus-states>

  <!-- ============================================================
       SECTION 9: COMPONENT PATTERNS
       ============================================================ -->
  <components>

    <!-- Container Pattern -->
    <component name="floating-panel">
      <description>Sidebars, floating toolbars, modal-like containers</description>
      <structure>
        <![CDATA[
<div style={{
  backgroundColor: 'var(--card)',
  border: 'none',
  borderRadius: 16,
  boxShadow: '0 8px 32px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.04)',
  backgroundImage: 'linear-gradient(180deg, rgba(255,255,255,0.03) 0%, transparent 60px)',
  overflow: 'hidden',
}}>
  {children}
</div>
        ]]>
      </structure>
      <key-properties>
        <property>No border (use shadow for definition)</property>
        <property>Large border-radius (16px)</property>
        <property>Subtle inner glow gradient</property>
        <property>Layered shadow for depth</property>
      </key-properties>
    </component>

    <!-- Tab Navigation Pattern -->
    <component name="pill-tabs">
      <description>Segmented control / pill-style tab navigation</description>
      <structure>
        <![CDATA[
<div className="p-1 bg-muted rounded-lg flex gap-0.5">
  {tabs.map(tab => (
    <button
      className={cn(
        'flex-1 px-4 py-2 rounded-lg text-sm',
        'transition-all duration-200',
        isActive
          ? 'bg-card text-foreground font-medium shadow-sm'
          : 'text-muted-foreground hover:text-foreground'
      )}
    >
      {tab.label}
    </button>
  ))}
</div>
        ]]>
      </structure>
      <key-properties>
        <property>Container: bg-muted, rounded-lg, p-1</property>
        <property>Active tab: bg-card, shadow-sm, font-medium</property>
        <property>Inactive: transparent, muted text</property>
        <property>Inner radius slightly smaller than outer</property>
      </key-properties>
    </component>

    <!-- Collapsible Section Pattern -->
    <component name="collapsible-section">
      <description>Expandable sections with header and content</description>
      <structure>
        <![CDATA[
<!-- Trigger -->
<div className="px-3 pt-4 pb-2">
  <button className={cn(
    'flex w-full items-center gap-3 rounded-lg px-2 py-2.5',
    'text-[13px] font-medium text-foreground',
    'transition-all duration-200 ease-out',
    'hover:bg-muted/60',
    'active:scale-[0.98]'
  )}>
    <div className={cn(
      'flex h-7 w-7 items-center justify-center rounded-lg',
      'transition-colors duration-200',
      open ? 'bg-primary/10 text-primary' : 'bg-muted/50 text-muted-foreground'
    )}>
      <Icon className="h-4 w-4" />
    </div>
    <span className="flex-1 text-left">{title}</span>
    <div className={cn(
      'h-1.5 w-1.5 rounded-full transition-all duration-200',
      open ? 'bg-primary' : 'bg-muted-foreground/30'
    )} />
  </button>
</div>

<!-- Content (animated) -->
<div style={{
  height: open ? measuredHeight : 0,
  opacity: open ? 1 : 0,
  overflow: (!open || isAnimating) ? 'hidden' : 'visible',
  transition: 'height 200ms ease-out, opacity 150ms ease-out',
}}>
  <div className="px-5 pb-5">
    {children}
  </div>
</div>
        ]]>
      </structure>
      <key-properties>
        <property>No chevron - use subtle dot indicator</property>
        <property>Icon tints to primary when open</property>
        <property>Animated height with overflow management</property>
        <property>Switch to overflow:visible after animation</property>
      </key-properties>
    </component>

    <!-- Input Field Pattern -->
    <component name="input-field">
      <description>Text inputs, textareas</description>
      <classes>
        <![CDATA[
h-10
rounded-lg
border border-border/50
bg-muted/30
text-sm
placeholder:text-muted-foreground/50
transition-all duration-150
focus-visible:outline-none
focus-visible:border-primary/40
focus-visible:ring-1
focus-visible:ring-ring
focus:bg-background
        ]]>
      </classes>
      <key-properties>
        <property>Height: 40px (h-10)</property>
        <property>Soft border at 50% opacity</property>
        <property>Tinted background (muted/30)</property>
        <property>Subtle focus: border darkens, thin ring</property>
        <property>Background lightens on focus</property>
      </key-properties>
    </component>

    <!-- Button Patterns -->
    <component name="button-primary">
      <description>Primary action buttons</description>
