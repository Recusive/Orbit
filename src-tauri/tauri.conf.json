{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbit",
  "version": "0.0.1",
  "identifier": "com.recursive.orbit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5176",
    "beforeDevCommand": "TAURI_DEBUG=true bun run dev:web",
    "beforeBuildCommand": "bun run build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Orbit",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "center": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 11,
          "y": 19
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' https://streamdown.ai http://localhost:5176 http://localhost:5199",
        "style-src": "'self' 'unsafe-inline' https://streamdown.ai http://localhost:*",
        "connect-src": "'self' https://api.anthropic.com ipc://localhost https://streamdown.ai http://localhost:* ws://localhost:* https://github.com https://*.githubusercontent.com",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: https://streamdown.ai",
        "worker-src": "'self' blob:",
        "frame-src": "'self' http://localhost:*",
        "object-src": "'none'"
      },
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agent-bridge", "binaries/claude"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "Modern AI-powered code editor",
    "longDescription": "Orbit is a modern code editor built with Tauri, React, and Rust, featuring an AI coding assistant.",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "15.0",
      "signingIdentity": "Developer ID Application: Pranit sharma (QSAMZF2NJ7)",
      "files": {
        "Resources/Assets.car": "resources/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3ODVEMDY5QUVENzM4ODkKUldTSk9OZXVhZENGRnpZMEIyVE9NZXhqbUZWM3VzN05aUjVuSGY0dmNBSGhtajAvMjQ3bEN2WGQK",
      "endpoints": [
        "https://github.com/Recusive/Orbit-Release/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
