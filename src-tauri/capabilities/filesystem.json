{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "filesystem",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:deny-read-text-file",
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/.local/share/**" },
        { "path": "$HOME/.password-store/**" },
        { "path": "$HOME/Library/Keychains/**" },
        { "path": "$HOME/Library/Application Support/1Password/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "**/.env" },
        { "path": "**/.env.*" },
        { "path": "**/credentials.json" },
        { "path": "**/secrets.json" },
        { "path": "**/*.pem" },
        { "path": "**/*.key" }
      ]
    },
    {
      "identifier": "fs:deny-write-text-file",
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/.local/share/**" },
        { "path": "$HOME/.password-store/**" },
        { "path": "$HOME/Library/Keychains/**" },
        { "path": "$HOME/Library/Application Support/1Password/**" },
        { "path": "$HOME/.kube/**" },
        { "path": "$HOME/.docker/**" },
        { "path": "**/.env" },
        { "path": "**/.env.*" },
        { "path": "**/credentials.json" },
        { "path": "**/secrets.json" },
        { "path": "**/*.pem" },
        { "path": "**/*.key" }
      ]
    }
  ]
}
