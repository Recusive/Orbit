{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "filesystem",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:deny-read-text-file",
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "**/.env" },
        { "path": "**/.env.*" }
      ]
    }
  ]
}
