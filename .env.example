# Apple Notarization Credentials
# Copy this file to .env and fill in your credentials
# Used by Tauri during `bun run build` for macOS notarization
#
# Note: The signing identity is hardcoded in src-tauri/tauri.conf.json
# These env vars are only needed for notarization (submitting to Apple)

# Apple ID email for notarization
APPLE_ID=your-email@example.com

# App-specific password (generate at https://appleid.apple.com/account/manage)
# Under "Sign-In and Security" → "App-Specific Passwords"
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Team ID from Apple Developer Portal (https://developer.apple.com/account)
# Found under Membership → Team ID
APPLE_TEAM_ID=XXXXXXXXXX
